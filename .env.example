# Copy this file to `.env` at the repo root (next to `package.json`).
# `.env` is gitignored — never commit it.
#
# These values are public-client desktop OAuth credentials. A release build embeds
# non-empty RUSTYMAIL_* OAuth vars from the environment or this file so the binary
# can complete PKCE + loopback without a RustyMail backend and without a runtime `.env`.

RUSTYMAIL_GOOGLE_OAUTH_CLIENT_ID=
# Google Desktop still requires this at token exchange (treated as non-confidential by Google).
RUSTYMAIL_GOOGLE_OAUTH_CLIENT_SECRET=
RUSTYMAIL_MICROSOFT_OAUTH_CLIENT_ID=
# Entra → Authentication → Mobile and desktop → register http://127.0.0.1:52789
# RUSTYMAIL_OAUTH_LOOPBACK_PORT=52789
# Do not enable in production: ephemeral port if 52789 is busy (discouraged for Entra)
# RUSTYMAIL_OAUTH_ALLOW_EPHEMERAL_PORT=0
