# Copy this file to `.env` at the repo root (next to `package.json`).
# `.env` is gitignored — never commit secrets.

RUSTYMAIL_GOOGLE_OAUTH_CLIENT_ID=
# Required: secret for the same OAuth client (Google Console → Credentials → Client secret).
# Recommended client type: Desktop app; Web application type also requires this secret.
RUSTYMAIL_GOOGLE_OAUTH_CLIENT_SECRET=
# RUSTYMAIL_MICROSOFT_OAUTH_CLIENT_ID=
# Entra → Authentication → Mobile and desktop → register http://127.0.0.1:52789 (default port)
# RUSTYMAIL_OAUTH_LOOPBACK_PORT=52789
# Do not enable in production: ephemeral port if 52789 is busy (discouraged for Entra)
# RUSTYMAIL_OAUTH_ALLOW_EPHEMERAL_PORT=0
