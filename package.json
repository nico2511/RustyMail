{
  "name": "rustymail2",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:personal": "tauri build",
    "verify:compile": "cargo check -p rustymail",
    "verify:fmt": "cargo fmt --all -- --check",
    "verify:clippy": "cargo clippy --workspace --all-targets",
    "verify:rust-test": "cargo test --workspace --lib --bins",
    "verify:ts": "tsc --noEmit",
    "verify:ci": "npm run verify:fmt && npm run verify:clippy && npm run verify:rust-test && npm run verify:ts && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "dompurify": "^3.4.1",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "happy-dom": "^20.14.5",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^3.2.4"
  }
}
