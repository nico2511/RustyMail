{
  "name": "rustymail2",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:personal": "tauri build --features embed-dev-oauth",
    "verify:compile": "cargo check -p rustymail",
    "verify:fmt": "cargo fmt --all -- --check",
    "verify:clippy": "cargo clippy --workspace --all-targets",
    "verify:rust-test": "cargo test --workspace --lib --bins",
    "verify:ts": "tsc --noEmit",
    "verify:ci": "npm run verify:fmt && npm run verify:clippy && npm run verify:rust-test && npm run verify:ts && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "dompurify": "^3.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^3.2.4"
  }
}
